http:
  routers:
    dashboard:
      rule: Host(`traefik-aly.grep2000.com`) && (PathPrefix(`/api`) || PathPrefix(`/dashboard/`))
      service: dashboard-service
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      middlewares:
        - auth-dashboard
      priority: 1000

  services:
    dashboard-service:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8080"   # ← 关键！宿主机端口
          
  middlewares:
    auth-dashboard:
      basicAuth:
        users:
          - "admin:$apr1$swPBZ14p$G/8g3SZn90lIeHYqVIanm1"

